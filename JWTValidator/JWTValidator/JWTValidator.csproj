<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The library's package ID is JWTValidator. Without a different ID here, restore fails with "Ambiguous project name". -->
    <PackageId>JWTValidator.ConsoleApp</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JWTValidatorService\JWTValidatorService.csproj" />
    <ProjectReference Include="..\JWTValidatorTests\JWTValidatorTests.csproj" />
  </ItemGroup>

</Project>
