<Project>

  <!-- Settings that every project in the solution shares. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- A known vulnerability in any package, direct or transitive, fails the restore.
       NU1900 (vulnerability data could not be downloaded) stays a warning, so a nuget.org outage does not fail the build. -->
  <PropertyGroup>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

</Project>
